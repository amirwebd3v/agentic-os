# Copy to .env (gitignored). The app reads ONLY this file for these values, never the inherited shell env.
# ANTHROPIC_BASE_URL may end in /v1 (it is stripped; the SDK appends /v1/messages itself).
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# Tier mapping: fast = HAIKU, work = ANTHROPIC_MODEL (else SONNET), deep = OPUS
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
# Claude Code's own variable; the app ignores it.
CLAUDE_CODE_SUBAGENT_MODEL=
# Optional: decider sidecar bearer key (otherwise generated into Credential Manager by `pnpm sidecar`).
LAYA_API_KEY=
