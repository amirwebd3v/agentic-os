filters:
  and:
    - file.inFolder("week1/tickets")
views:
  - type: kanban
    name: Board
    groupBy:
      property: note.status
      direction: ASC
    groupOrder:
      - Backlog
      - In progress
      - Review
      - Done
    order:
      - file.name
      - note.points
      - note.wave
      - note.risk
  - type: table
    name: By wave
    groupBy:
      property: note.wave
      direction: ASC
    order:
      - file.name
      - note.title
      - note.status
      - note.points
      - note.risk
      - note.depends_on
      - note.skills
      - note.completed
    summaries:
      note.points: Sum
